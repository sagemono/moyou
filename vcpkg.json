{
  "name": "moyou",
  "version-string": "1.0.0",
  "description": "Theming tool for the PS3 XMB wave",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "opengl",
        "png",
        "freetype",
        "harfbuzz",
        { "name": "fontconfig", "platform": "linux" },
        { "name": "xcb", "platform": "linux" },
        { "name": "xkb", "platform": "linux" },
        { "name": "xkbcommon-x11", "platform": "linux" },
        { "name": "egl", "platform": "linux" }
      ]
    },
    "zlib",
    "catch2"
  ]
}
